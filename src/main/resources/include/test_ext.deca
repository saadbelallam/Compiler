// Description : 
//    Ce fichier teste et compare les fonctions cordicSin, sinTaylor, et sine de la classe Math.
//    Il inclut des cas de tests pour des angles variés avec des itérations différentes, ainsi que des tests pour des nombres extrêmes.
//
// Résultats : 
//    Affiche les valeurs du sinus calculées pour chaque méthode et les différences entre elles, y compris pour des valeurs très grandes ou très petites.
//
// Historique : 
//    Créé le 22/01/2025. Modifié pour inclure des tests sur des nombres extrêmes.

#include "Math.decah"

{
    Math m = new Math();
    int iterations;
    float angle;
    float sinCordic, sinTaylor, sinDirect;

    iterations = 31; // Nombre d'itérations pour cordicSin et sinTaylor

    // Test pour angle = 0
    angle = 0.0;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9); // Ordre 10 pour sinTaylor
    sinDirect = m.sine(angle);
    print("Angle: 0.0 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = PI
    angle = m.pi;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9); // Ordre 10 pour sinTaylor
    sinDirect = m.sine(angle);
    print("Angle: PI | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = PI/6
    angle = m.pi / 6;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: PI/6 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = PI/4
    angle = m.pi / 4;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: PI/4 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = PI/2
    angle = m.pi / 2;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: PI/2 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = -PI/4
    angle = -m.pi / 4;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: -PI/4 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = 3*PI/2
    angle = 3 * m.pi / 2;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: 3*PI/2 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour angle = -3*PI/2
    angle = -3 * m.pi / 2;
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: -3*PI/2 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour un angle très grand (exemple : 2^15)
    angle = m.puissance(2, 15); // Très grand angle
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: 2^15 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Test pour un angle très petit (exemple : 2^-15)
    angle = m.puissance(2, -15); // Très petit angle
    sinCordic = m.cordicSin(angle, iterations);
    sinTaylor = m.sinTaylor(angle, 9);
    sinDirect = m.sine(angle);
    print("Angle: 2^-15 | cordicSin: ");
    print(sinCordic);
    print(" | sinTaylor: ");
    print(sinTaylor);
    print(" | sine: ");
    print(sinDirect);
    println("");

    // Fin des tests
    println("Tests terminés.");
}
