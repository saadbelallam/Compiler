// Grenoble INP - Ensimag projet GL -*- mode: java -*-
// Library for class Math of Deca, coded in Deca

class Math {
    float pi = 3.14159265;
     // Facteur correctif du CORDIC (environ 1/K∞)
    float CORDIC_GAIN_INV = 0.60725293f;

    float _puissance(float x, int n) {
        float res = 1.0;

        // Si l'exposant est négatif
        if (n < 0) {
            x = 1.0 / x; 
            n = -n;      
        }

        while (n > 0) {
            res = res * x; 
            n = n - 1;              
        }

        return res;
    }

    float _abs(float x) {
        if (x > 0) {
            return x;
        }
        else {
            return -x;
        }
    }

    int _fact(int n) {
        int res = 1;
        if (n == 0 || n == 1) {
            return res;
        }

        while (n > 1) {
            res = res * n;
            n = n - 1;
        }
        
        return res;
    }


    float _reduce(float f) {
        float val;
        int q = ((int)(f / (2.0 * pi)));
        val = _fma(f, q , -(2.0 * pi));
        if (val > pi) {
            val = val - 2 * pi;
        }
        if (val < -pi) {
            val = val + 2 * pi;
        }
        return val;
    }

    float _reduce_cordic(float val) {
    if (val > pi / 2) {
        val = pi - val;
    } else if (val < -pi / 2) {
        val = -pi - val;
    }

    return val;
}



    float _reduce_sin(float f) {
        while (f > pi/2) {
            f = pi - f;
        }
        while (f < -pi/2) {
            f = -(f + pi);
        }
    
        return f;
    }

    
    float _reduce_cos(float f) {
        if (f < 0) {
            f = -f;
        }
        return f;
    }

    // a + b*c
    float _fma(float a, float b, float c) asm (
        "LOAD -3(LB), R1    
         LOAD -4(LB), R2     
         LOAD -5(LB), R3     
         FMA R2, R3    
         LOAD R3, R0
         RTS"               
    );

    int _getExponent(float x) {
        float absValue = _abs(x);
        int exponent = 0;

        while (absValue >= 2.0) {
            absValue = absValue / 2.0;
            exponent = exponent + 1;
        }
        while (absValue < 1.0 && absValue > 0.0) {
            absValue = absValue * 2.0;
            exponent = exponent - 1;
        }

        return exponent;
    }


    float _sinTaylor(float f, int order) {
        float sign;
        float x;
        float fact_i;
        int i = order;
        float res = f;

        f = _reduce(f);
        f = _reduce_sin(f);
        res = f;
        
        if (f == 0) {
            return 0;
        }

        while (i > 0) {
            sign = _puissance(-1,i);
            x = _puissance(f,2*i+1);
            fact_i = _fact(2*i+1);
            // res = res + sign*x/fact_i;
            res = _fma(res, sign, x/fact_i );
            i = i - 1;
        }
        return res;
    }


    float _cosTaylor(float f, int order) {
        float sign;
        float x;
        float fact_j;
        int j = order;
        float res = 1;

        f = _reduce(f);
        f = _reduce_cos(f);
        
        if (f == 0) {
            return 1;
        }

        while (j > 0) {
            sign = _puissance(-1,j);
            x = _puissance(f,2*j);
            fact_j = _fact(2*j);
            // res = res + sign*x/fact_j;
            res = _fma(res, sign, x/fact_j);
            j = j - 1;

        }
        return res;
    }


    float _asinTaylor(float f, int order) {
        float x;
        float fact_num;
        float fact_den;
        float res = f;
        float a;
        float b;

        if (f > 1.0 || f < -1.0) {
            println("asin(",f,") : f doit être compris entre -1 et 1");
            return 0;
        }

        if (f == 0) {
            return 0;
        }
        if (f == 1) {
            return pi/2;
        }
        if (f == -1) {
            return -pi/2;
        }

        while (order > 0) {
            fact_num = _fact(2*order);
            a = _fact(order);
            b = _puissance(2,order);
            fact_den = _puissance(a*b,2);
            x = _puissance(f, 2*order + 1);
            res = res + (x*fact_num)/(fact_den*(2*order + 1));
            order = order - 1;
        }
        return res;
    }

    float _atanTaylor(float f, int order) {
        float sign;
        float x;
        float res;
        float a;
        float b;
        boolean inv = false;
        boolean neg = false;

        if (f == 0) {
            return 0;
        }

        if (f == 1) {
            return pi/4;
        }

        if (f == -1) {
            return -pi/4;
        }

        if (f < -1) {
            neg = true;
            f = -f;
        }

        if (f > 1) {
            inv = true;
            f = 1/f;
        }
        
        res = f;
        while (order > 0) {
            sign = _puissance(-1, order);
            x = _puissance(f, 2*order + 1);
            res = res + sign*x/(2*order + 1);
            order = order - 1;
        }

        if (inv) {
            res = pi/2 - res;
        }

        if (neg) {
            res = -res;
        }

        return res;

    }


    float _atanValue(int i) {
        if (i == 0) { return 0.785398163f; }  // ~ π/4
        else if (i == 1) { return 0.463647609f; }
        else if (i == 2) { return 0.244978663f; }
        else if (i == 3) { return 0.124354995f; }
        else if (i == 4) { return 0.062418810f; }
        else if (i == 5) { return 0.031239833f; }
        else if (i == 6) { return 0.015623729f; }
        else if (i == 7) { return 0.007812341f; }
        else if (i == 8) { return 0.003906230f; }
        else if (i == 9) { return 0.001953123f; }
        else if (i == 10) { return 0.000976562f; }
        else if (i == 11) { return 0.000488281f; }
        else if (i == 12) { return 0.000244141f; }
        else if (i == 13) { return 0.000122070f; }
        else if (i == 14) { return 0.000061035f; }
        else if (i == 15) { return 0.000030518f; }
        else if (i == 16) { return 0.000015259f; }
        else if (i == 17) { return 0.000007629f; }
        else if (i == 18) { return 0.000003815f; }
        else if (i == 19) { return 0.000001907f; }
        else if (i == 20) { return 0.000000954f; }
        else if (i == 21) { return 0.000000477f; }
        else if (i == 22) { return 0.000000238f; }
        else if (i == 23) { return 0.000000119f; }
        else if (i == 24) { return 0.000000059f; }
        else if (i == 25) { return 0.000000030f; }
        else if (i == 26) { return 0.000000015f; }
        else if (i == 27) { return 0.000000007f; }
        else if (i == 28) { return 0.000000003f; }
        else if (i == 29) { return 0.0000000015f; }
        else if (i == 30) { return 0.0000000007f; }
        else if (i == 31) { return 0.00000000035f;}
        return 0.0f; // Au-delà, on renvoie 0
    }




float _cordicSin(float angle, int iterations) {
    float x = 1.0;
    float y = 0.0;
    float angl = _reduce(angle);
    float z = _reduce_cordic(angl);  // Réduction de l'angle
    float powerOfTwo = 1.0;
    int i = 0;
    float angleStep;
    float x_new;
    float y_new;
    // Identifier le quadrant d'origine pour déterminer le signe du sinus
    boolean isNegativeSin = false;
    if (angl > -pi && angl <=0) {
        isNegativeSin = true;
    }

    // Algorithme CORDIC
    while (i < iterations && i < 50) {
        angleStep = _atanValue(i);

        if (z < 0.0) {
            x_new = x + (y / powerOfTwo);
            y_new = y - (x / powerOfTwo);
            z = z + angleStep;
        } else {
            x_new = x - (y / powerOfTwo);
            y_new = y + (x / powerOfTwo);
            z = z - angleStep;
        }

        x = x_new;
        y = y_new;

        powerOfTwo = powerOfTwo * 2.0;
        i = i + 1;
    }

    // Compensation du gain CORDIC
    y = y * CORDIC_GAIN_INV;

    // Appliquer la réflexion pour corriger le signe
    if (isNegativeSin) {
        y = y;
    }

    return y;
}


 float _cordicCos(float angle, int iterations) {
    float x = 1.0;
    float y = 0.0;
    float angl = _reduce(angle);
    float z = _reduce_cordic(angl);  // Réduction de l'angle
    float powerOfTwo = 1.0;
    int i = 0;
    float angleStep;
    float x_new;
    float y_new;

    // Identifier le quadrant d'origine pour déterminer le signe du cosinus
    boolean isNegativeCos = false;
    if (angl > pi / 2 && angl <= pi || angl > -pi && angl  < -pi /2) {
        isNegativeCos = true;
    }

    // Algorithme CORDIC
    while (i < iterations && i < 50) {
        angleStep = _atanValue(i);

        if (z < 0.0) {
            x_new = x + (y / powerOfTwo);
            y_new = y - (x / powerOfTwo);
            z = z + angleStep;
        } else {
            x_new = x - (y / powerOfTwo);
            y_new = y + (x / powerOfTwo);
            z = z - angleStep;
        }

        x = x_new;
        y = y_new;

        powerOfTwo = powerOfTwo * 2.0;
        i = i + 1;
    }

    // Compensation du gain CORDIC
    x = x * CORDIC_GAIN_INV;

    // Appliquer la réflexion pour corriger le signe
    if (isNegativeCos) {
        x = -x;
    }

    return x;
}



    float sin(float x) {
        float p11; 
        float p9 ; 
        float p7 ; 
        float p5 ; 
        float p3 ; 
        float p1 ; 
        // Coefficients de la série de Taylor (ordre élevé pour précision)
        float coeff11 = 0.00000000013291342;
        float coeff9  = -0.000000023317787;
        float coeff7  = 0.0000025222919;
        float coeff5  = -0.00017350505;
        float coeff3  = 0.0066208798;
        float coeff1  = -0.10132118;

        // Valeurs de pi avec une précision étendue
        float pi_major = 3.1415927;
        float pi_minor = -0.00000008742278;
        float x2 ;
        x = _reduce(x);
        // Calcul des puissances de x
        x2 = x * x;

        // Méthode de Horner pour évaluer le polynôme
        p11 = coeff11;
        p9  = p11 * x2 + coeff9;
        p7  = p9  * x2 + coeff7;
        p5  = p7  * x2 + coeff5;
        p3  = p5  * x2 + coeff3;
        p1  = p3  * x2 + coeff1;

        // Calcul final de sin(x)
        return (x - pi_major - pi_minor) * (x + pi_major + pi_minor) * p1 * x;
    }
    

    float cos(float x) {
        // Décalage de π/2 pour transformer sin en cos
        // cos(x) = sin(x + π/2)
        float piHalf_major = 1.5707963;   // π/2 partie majeure
        float piHalf_minor = -0.00000004371139;  // π/2 partie mineure
        
        // Ajouter π/2 à x
        float adjustedX = x + piHalf_major + piHalf_minor;
        
        // Utiliser la fonction sine existante
        return sin(adjustedX);
    }

    float asin(float x) {
        return _asinTaylor(x, 5);
    }

    float atan(float x) {
        return _atanTaylor(x, 5);
    }

    float ulp(float x) {
        int exponent;
        if (x == 0.0f) {
            return _puissance(2.0, -149);
        }

        exponent = _getExponent(x);

        if (exponent < -126) {
            return _puissance(2.0, -149);
        }

        return _puissance(2.0, exponent - 23);
    }
}

// End of Deca Math library

