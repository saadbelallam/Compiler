// Library for class Math of Deca, coded in Deca

class Math {
    float pi = 3.14159265;
     // Facteur correctif du CORDIC (environ 1/K∞)
    float CORDIC_GAIN_INV = 0.60725293f;

    float puissance(float x, int n) {
        float res = 1.0;

        // Si l'exposant est négatif
        if (n < 0) {
            x = 1.0 / x; 
            n = -n;      
        }

        while (n > 0) {
            res = res * x; 
            n = n - 1;              
        }

        return res;
    }

    float abs (float x) {
        if (x > 0) {
            return x;
        }
        else {
            return -x;
        }
    }

    int fact(int n) {
        int res = 1;
        if (n == 0 || n == 1) {
            return res;
        }

        while (n > 1) {
            res = res * n;
            n = n - 1;
        }
        
        return res;
    }

float reduce(float f) {
    // Réduction dans l'intervalle [-pi, pi]
    while (f > pi) {
        f = f - 2 * pi;
    }
    while (f < -pi) {
        f = f + 2 * pi;
    }

    // Ajustement pour placer l'angle dans [-pi/2, pi/2]
    if (f > pi / 2) {
        f = f - pi;
    } else if (f < -pi / 2) {
        f = f + pi;
    }

    return f;
}


    int getExponent(float x) {
        float absValue = abs(x);
        int exponent = 0;

        while (absValue >= 2.0) {
            absValue = absValue / 2.0;
            exponent = exponent + 1;
        }
        while (absValue < 1.0 && absValue > 0.0) {
            absValue = absValue * 2.0;
            exponent = exponent - 1;
        }

        return exponent;
    }

    float sinTaylor(float f, int order) {
        float sign;
        float x;
        float fact_i;
        int i = order;
        float res = f;

        f = reduce(f);
        
        if (f == 0) {
            return 0;
        }

        while (i > 0) {
            sign = puissance(-1,i);
            x = puissance(f,2*i+1);
            fact_i = fact(2*i+1);
            res = res + sign*x/fact_i;
            i = i - 1;
        }
        println(res);
        return res;
    }

    float ulp(float x) {
        int exponent;
        if (x == 0.0f) {
            return puissance(2.0, -149);
        }

        exponent = getExponent(x);

        if (exponent < -126) {
            return puissance(2.0, -149);
        }

        return puissance(2.0, exponent - 23);
    }

float atanValue(int i) {
    if (i == 0) { return 0.785398163f; }  // ~ π/4
    else if (i == 1) { return 0.463647609f; }
    else if (i == 2) { return 0.244978663f; }
    else if (i == 3) { return 0.124354995f; }
    else if (i == 4) { return 0.062418810f; }
    else if (i == 5) { return 0.031239833f; }
    else if (i == 6) { return 0.015623729f; }
    else if (i == 7) { return 0.007812341f; }
    else if (i == 8) { return 0.003906230f; }
    else if (i == 9) { return 0.001953123f; }
    else if (i == 10) { return 0.000976562f; }
    else if (i == 11) { return 0.000488281f; }
    else if (i == 12) { return 0.000244141f; }
    else if (i == 13) { return 0.000122070f; }
    else if (i == 14) { return 0.000061035f; }
    else if (i == 15) { return 0.000030518f; }
    else if (i == 16) { return 0.000015259f; }
    else if (i == 17) { return 0.000007629f; }
    else if (i == 18) { return 0.000003815f; }
    else if (i == 19) { return 0.000001907f; }
    else if (i == 20) { return 0.000000954f; }
    else if (i == 21) { return 0.000000477f; }
    else if (i == 22) { return 0.000000238f; }
    else if (i == 23) { return 0.000000119f; }
    else if (i == 24) { return 0.000000059f; }
    else if (i == 25) { return 0.000000030f; }
    else if (i == 26) { return 0.000000015f; }
    else if (i == 27) { return 0.000000007f; }
    else if (i == 28) { return 0.000000003f; }
    else if (i == 29) { return 0.0000000015f; }
    else if (i == 30) { return 0.0000000007f; }
    else if (i == 31) { return 0.00000000035f; }
    else if (i == 32) { return 0.00000000017f; }
    else if (i == 33) { return 0.000000000087f; }
    else if (i == 34) { return 0.000000000043f; }
    else if (i == 35) { return 0.000000000021f; }
    else if (i == 36) { return 0.000000000010f; }
    else if (i == 37) { return 0.000000000005f; }
    else if (i == 38) { return 0.0000000000025f; }
    else if (i == 39) { return 0.0000000000012f; }
    else if (i == 40) { return 0.0000000000006f; }
    else if (i == 41) { return 0.0000000000003f; }
    else if (i == 42) { return 0.00000000000015f; }
    else if (i == 43) { return 0.00000000000007f; }
    else if (i == 44) { return 0.000000000000035f; }
    else if (i == 45) { return 0.000000000000017f; }
    else if (i == 46) { return 0.000000000000008f; }
    else if (i == 47) { return 0.000000000000004f; }
    else if (i == 48) { return 0.000000000000002f; }
    else if (i == 49) { return 0.000000000000001f; }
    return 0.0f; // Au-delà, on renvoie 0
}




float cordicSin(float angle, int iterations) {
    float x = 1.0f;
    float y = 0.0f;
    float z = reduce(angle);      // Ramène l’angle dans [-π, π]
    float powerOfTwo = 1.0f;
    int i = 0;
    float angleStep;
    float x_new;
    float y_new;

    // On effectue jusqu'à 'iterations' rotations, mais max 24 (puisque atanValue() = 0 au-delà).
    while ((i < iterations) && (i < 50)) {
        angleStep = atanValue(i);

        if (z < 0.0f) {
            x_new = x + (y / powerOfTwo);
            y_new = y - (x / powerOfTwo);
            z = z + angleStep;
        } else {
            x_new = x - (y / powerOfTwo);
            y_new = y + (x / powerOfTwo);
            z = z - angleStep;
        }

        x = x_new;  
        y = y_new;

        powerOfTwo = powerOfTwo * 2.0f;
        i = i + 1;
    }

    // Compensation du gain CORDIC
    return y * CORDIC_GAIN_INV;
}

float cordicCos(float angle, int iterations) {
    float x = 1.0f;
    float y = 0.0f;
    float z = reduce(angle);
    float powerOfTwo = 1.0f;
    int i = 0;
    float angleStep;
    float x_new;
    float y_new;

    while ((i < iterations) && (i < 50)) {
        angleStep = atanValue(i);

        if (z < 0.0f) {
            x_new = x + (y / powerOfTwo);
            y_new = y - (x / powerOfTwo);
            z = z + angleStep;
        } else {
            x_new = x - (y / powerOfTwo);
            y_new = y + (x / powerOfTwo);
            z = z - angleStep;
        }

        x = x_new;
        y = y_new;

        powerOfTwo = powerOfTwo * 2.0f;
        i = i + 1;
    }

    // Compensation du gain CORDIC
    return x * CORDIC_GAIN_INV;
}
}

// End of Deca Math library

