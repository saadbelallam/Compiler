// Grenoble INP - Ensimag projet GL -*- mode: java -*-
// Library for class Math of Deca, coded in Deca

class Math {
    float pi = 3.1415926;

    float puissance(float x, int n) {
        float res = 1.0;

        // Si l'exposant est négatif
        if (n < 0) {
            x = 1.0 / x; 
            n = -n;      
        }

        while (n > 0) {
            res = res * x; 
            n = n - 1;              
        }

        return res;
    }

    int fact(int n) {
        int res = 1;
        if (n == 0 || n == 1) {
            return res;
        }

        while (n > 1) {
            res = res * n;
            n = n - 1;
        }
        
        return res;
    }

    float reduce(float f) {
        while (f > pi) {
            f = f - 2*pi;
        }
        while (f < -pi) {
            f = f + 2*pi;
        }
    
        return f;
    }


    // Fonction auxiliaire : calcule l’exposant « non biaisé » d'un float
    // en ramenant sa valeur absolue dans l’intervalle [1,2[.
    int getExponent(float x) {
        absValue = op.abs(x);
        exponent = 0;

        // Normalisation vers le bas (si >= 2.0)
        while (absValue >= 2.0) {
            absValue = absValue / 2.0;
            exponent = exponent + 1;
        }
        // Normalisation vers le haut (si < 1.0)
        while (absValue < 1.0 && absValue > 0.0) {
            absValue = absValue * 2.0;
            exponent = exponent - 1;
        }

        return exponent;
    }


    float sinTaylor(float f, int order) {
        float sign;
        float x;
        float fact_i;
        int i = order;
        float res = f;

        f = reduce(f);
        
        if (f == 0) {
            return 0;
        }

        while (i > 0) {
            sign = puissance(-1,i);
            x = puissance(f,2*i+1);
            fact_i = fact(2*i+1);
            res = res + sign*x/fact_i;
            i = i - 1;
        }
        println(res);
        return res;
    }

    
    
    float ulp(float x) {
        // Cas pour zéro : retourne la plus petite valeur positive sous-normalisée (2^-149)
        if (x == 0.0f) {
            return puissance(2.0, -149);
        }

        // Extraction de l’exposant « non biaisé »
        exponent = getExponent(x);

        // Sous-normal si exponent < -126
        //   => renvoie la plus petite distance positive (2^-149)
        if (exponent < -126) {
            return puissance(2.0, -149);
        }

        // Sinon, c’est un nombre normal => ULP = 2^(exponent - 23)
        return puissance(2.0, exponent - 23);
    }

    
}



// End of Deca Math library
