#include "fonctions.deca"
// Grenoble INP - Ensimag projet GL -*- mode: java -*-
// Library for class Math of Deca, coded in Deca

class Math {
    OperationsMath op;

    float ulp(float x) {
    int exponent;

    // Cas pour zéro : retourne la plus petite valeur positive sous-normalisée
    if (x == 0.0) {
        return op.puissance(2.0, -149);
    }

    // Extraction de l'exposant biaisé
    exponent = getExponent(x);

    // Cas pour les nombres sous-normalisés
    if (exponent == 0) {
        return op.puissance(2.0, -149);
    }

    // Calcul de l'ULP pour les nombres normalisés : 2^(e - 23)
    return op.puissance(2.0, exponent - 23);
}

    // Fonction auxiliaire : extrait l'exposant biaisé d'un flottant
    int getExponent(float x) {
    float absValue = op.abs(x);
    int exponent = 0;

    // Normalisation : ramène absValue dans l'intervalle [1, 2[
    while (absValue >= 2.0) {
        absValue = absValue / 2.0;
        exponent = exponent + 1;
    }
    while (absValue < 1.0 && absValue > 0.0) {
        absValue = absValue * 2.0;
        exponent = exponent - 1;
    }

    // Ajouter le biais de 127 pour obtenir l'exposant biaisé
    exponent = exponent + 127;
    return exponent;
}
}


// End of Deca Math library
