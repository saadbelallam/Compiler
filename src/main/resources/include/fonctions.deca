class OperationsMath {
    // fonctions intermédiaires: max, min, puissance, factoriel et définition de pi à 10⁻7 près 
    int resl;
    float max(float a, float b) {
        if (a > b) {
            return a;
        }

        else {
            return b;
        }
    }

    float abs (float x) {
        if (x > 0) {
            return x;
        }
        else {
            return -x;
        }
    }

    float min(float a, float b) {
        if (a < b) {
            return a;
        }

        else {
            return b;
        }
    }

    float puissance(float x, int n) {
    float res = 1.0;

    // Si l'exposant est négatif
    if (n < 0) {
        x = 1.0 / x; 
        n = -n;      
    }

    while (n > 0) {
        res = res * x; 
        n = n - 1;              
    }

    return res;
}

int fact(int n) {
    resl = 1;
    if (n == 0 || n == 1) {
        return resl;
    }

    while (n > 1) {
        resl = resl * n;
        n = n - 1;
    }
    
    return resl;
}

float PI() {
    return 3.1415926;  // reorésentation à 10⁻7
}


}

class MethodeTchebychev {

    // transforme un réel x dans [0, PI/2] en un réel dans [-1;1]
    
    float reductionIntervalleTchebychev (float x) {
        OperationsMath op;
        if (x >= -1 || x <= 1) {
            return x;
        }
        return (2*x/op.PI()) - 1;
    }


}