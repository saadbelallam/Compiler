// Description:
//    Utilisation de instanceof avec upcast implicite.
//
// Résultats:
//    Valide syntaxiquement et contextuellement.
//
// Historique:
//    créé le 18/01/2025

class A {}
class B extends A {}

class Main {
    void main() {
        A o = new B();
        if (o instanceof A) {
            println("C'est carré");
        }
    }
}
