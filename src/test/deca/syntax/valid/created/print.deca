{
    print("Hello, Deca!");         // Instruction PRINT
    println("New Line");           // Instruction PRINTLN
    printx("Hexadecimal Test");    // Instruction PRINTX
    printlnx("Hexadecimal Line");  // Instruction PRINTLNX
}