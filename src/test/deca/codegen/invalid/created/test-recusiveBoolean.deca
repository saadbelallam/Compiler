/* 
Results :

    Result of nested AND: false
    Result of nested OR: true
    Result of mixed AND/OR: true

 */
{
    
    boolean a;
    boolean b;
    boolean c;
    boolean d;
    boolean e;
    boolean f;
    boolean g;
    boolean h;
    boolean i;
    boolean j;
    boolean k;
    boolean l;
    boolean m;
    boolean n;
    boolean o;
    boolean result;
    
    
    a = true;
    b = false;
    c = true;
    d = true;
    e = false;
    f = true;
    g = true;
    h = false;
    i = true;
    j = true;
    k = false;
    l = true;
    m = true;
    n = false;
    o = true;
    
   
    result = a && (
                b && (
                    c && (
                        d && (
                            e && (
                                f && (
                                    g && (
                                        h && (
                                            i && (
                                                j && (
                                                    k && (
                                                        l && (
                                                            m && (
                                                                n && o
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            );
    
    println("Result of nested AND: ", result);
    
    
    result = a || (
                b || (
                    c || (
                        d || (
                            e || (
                                f || (
                                    g || (
                                        h || (
                                            i || (
                                                j || (
                                                    k || (
                                                        l || (
                                                            m || (
                                                                n || o
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            );
    
    println("Result of nested OR: ", result);
    
    
    result = a && (
                b || (
                    c && (
                        d || (
                            e && (
                                f || (
                                    g && (
                                        h || (
                                            i && (
                                                j || (
                                                    k && (
                                                        l || (
                                                            m && (
                                                                n || o
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            );
    
    println("Result of mixed AND/OR: ", result);
}
