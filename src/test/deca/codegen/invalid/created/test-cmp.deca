/* 
Results : 
    Test 1 - Complex boolean: true
    Branch 1: z=1 a=false
    Loop iteration - x=10 y=5 result=true
    Branch 1: z=2 a=true
    Loop iteration - x=9 y=4 result=true
    Branch 1: z=3 a=false
    Loop iteration - x=8 y=3 result=true
    Branch 1: z=4 a=true
    Loop iteration - x=7 y=2 result=true
    Branch 1: z=5 a=false
    Loop iteration - x=6 y=1 result=true
    Branch 2: z=7 b=true
    Loop iteration - x=5 y=0 result=true
    Test 3 - Final result: false
    Final values:
    x=4 y=-1 z=7
    a=false b=true c=true
    result=false 
*/            
{
  
    int x;
    int y;
    int z;
    boolean a;
    boolean b;
    boolean c;
    boolean result;
    
    x = 10;
    y = 5;
    z = 0;
    a = true;
    b = false;
    c = true;
    
    // Test 1: Complex boolean expression with AND/OR
    result = (a && b) || (c && !b);
    println("Test 1 - Complex boolean: ", result); // Should be true
    
    // Test 2: While loop with compound condition
    while (x > 0 && y >= 0) {
        // Test nested if with multiple conditions
        if ((x > 8 && y > 3) || (z < 5 && !b)) {
            z = z + 1;
            a = !a && c;  // Test boolean assignment
            println("Branch 1: z=", z, " a=", a);
        } else if (x % 2 == 0 || y % 2 == 0) {
            z = z + 2;
            b = !b || a;  // More boolean operations
            println("Branch 2: z=", z, " b=", b);
        } else {
            z = z + 3;
            c = !(a || b);  // Test NOT with OR
            println("Branch 3: z=", z, " c=", c);
        }
        
        // Complex boolean expression inside while
        result = (a && !b) || (c && (x > y));
        println("Loop iteration - x=", x, " y=", y, " result=", result);
        
        // Update counters
        x = x - 1;
        y = y - 1;
    }
    
    // Test 3: Final complex boolean expression
    result = (a && b && c) || (!a && !b && !c) || (x == y && z > 0);
    println("Test 3 - Final result: ", result);
    
    // Print final values
    println("Final values:");
    println("x=", x, " y=", y, " z=", z);
    println("a=", a, " b=", b, " c=", c);
    println("result=", result);
}
