// Description:
//    Vérifie la gestion des boucles et des conditions imbriquées.
//
// Résultats:
//    Le programme doit se terminer correctement.
//
// Historique:
//    Créé le 19/01/2025.

{
    int i;
    i = 0;
    while (i < 10) {
        if (i % 2 == 0) {
            println("Pair: " + i);
        } else {
            println("Impair: " + i);
        }
        i = i + 1;
    }
}
