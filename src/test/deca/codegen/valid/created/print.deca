{
    print("Hello, Deca!");         // Instruction PRINT
    println("New Line");           // Instruction PRINTLN
    printx(" ");
    printlnx("  ");
    printx(2.0);    // Instruction PRINTX
    printlnx(2.0);  // Instruction PRINTLNX
    printx(2);
    printlnx(2);
}