/* 
Results : 
    Complex expression result:true
    Deep nest 1
    Deep nest 2
    Deep nest 2
    Chain result:true
                     */         
{
    // All variable declarations at the top
    int a;
    int b;
    int c;
    int d;
    int e;
    int f;
    int g;
    int h;
    int x;
    boolean result;
    boolean p;
    boolean q;
    boolean r;
    boolean s;
    
    // Initialize variables
    a = 1;
    b = 2;
    c = 3;
    d = 4;
    e = 5;
    f = 6;
    g = 7;
    h = 8;
    
    // Test 1: Maximum register pressure
    result = (a < b && c < d) || (e < f && g < h);

    // Test 2: Deep nesting
    x = 10;
    while (x > 0) {
        if (x > 5) {
            if (x > 7) {
                if (x > 9) {
                    println("Deep nest 1");
                } else {
                    println("Deep nest 2");
                }
            }
        }
        x = x - 1;
    }

    // Test 3: Boolean expression chain
    p = true;
    q = false;
    r = true;
    s = false;
    
    result = p && q || r && !s || p && !q;
}
