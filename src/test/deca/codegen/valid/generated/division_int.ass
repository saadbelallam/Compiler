; start main program
	TSTO #3	; 0 (temporaires) 3 (variables)
	BOV stack_overflow_error
; Main program
; Variables declarations:
; Variable declaration: a
; Variable declaration: b
; Variable declaration: result
; Beginning of main instructions:
; Assignment to a
	LOAD #9, R2
	STORE R2, 1(GB)
; Assignment to b
	LOAD #3, R2
	STORE R2, 2(GB)
; Assignment to result
; allocate R3
	LOAD 1(GB), R2
	LOAD 2(GB), R3
	QUO R3, R2
	BOV div_by_zero_error	; Overflow check for previous operation
; release R3
	STORE R2, 3(GB)
; Load in R1 to be able to display
	LOAD 3(GB), R1
	WINT
	WNL
	HALT
; end main program
stack_overflow_error:
	WSTR "Error: Stack Overflow"
	WNL
	ERROR
div_by_zero_error:
	WSTR "Error: Division by zero"
	WNL
	ERROR
