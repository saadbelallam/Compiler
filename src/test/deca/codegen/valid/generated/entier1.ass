; start main program
	TSTO #1	; 0 (temporaires) 1 (variables)
	BOV stack_overflow_error
; Main program
; Variables declarations:
; Variable declaration: i
; Beginning of main instructions:
; Assignment to i
	LOAD #1, R2
	STORE R2, 1(GB)
; Load in R1 to be able to display
	LOAD 1(GB), R1
	WINT
	WNL
; Assignment to i
	LOAD 1(GB), R2
; allocate R3
	LOAD #1, R3
	ADD R3, R2
; No need for overflow check for type int
; release R3
	STORE R2, 1(GB)
; Load in R1 to be able to display
	LOAD 1(GB), R1
	WINT
	WNL
	HALT
; end main program
stack_overflow_error:
	WSTR "Error: Stack Overflow"
	WNL
	ERROR
