; start main program
	TSTO #2	; 0 (temporaires) 2 (variables)
	BOV stack_overflow_error
; Main program
; Variables declarations:
; Variable declaration: u
; allocate R2
	LOAD #42, R2
	STORE R2, 1(GB)
; release R2
; Variable declaration: v
; allocate R2
	LOAD #0, R2
	STORE R2, 2(GB)
; release R2
; Beginning of main instructions:
	BRA while_test_0
while_body_1:
; Beginning of if-then-else statement
	LOAD 1(GB), R2
	LOAD #2, R4
	REM R4, R2
	BOV div_by_zero_error	; Overflow check for previous operation
	LOAD #0, R3
	CMP R3, R2
	BNE E_Sinon.3
; Assignment to u
; allocate R2
	LOAD 1(GB), R3
	LOAD #2, R2
	QUO R2, R3
	BOV div_by_zero_error	; Overflow check for previous operation
; release R2
	STORE R3, 1(GB)
	BRA E_Fin.4
E_Sinon.3:
; Assignment to u
	LOAD #2, R3
; allocate R2
	LOAD 1(GB), R2
	MUL R2, R3
; No need for overflow check for type int
; release R2
; allocate R2
	LOAD 1(GB), R2
	ADD R2, R3
; No need for overflow check for type int
; release R2
; allocate R2
	LOAD #1, R2
	ADD R2, R3
; No need for overflow check for type int
; release R2
	STORE R3, 1(GB)
E_Fin.4:
; End of if-then-else statement
; Assignment to v
	LOAD 2(GB), R3
; allocate R2
	LOAD #1, R2
	ADD R2, R3
; No need for overflow check for type int
; release R2
	STORE R3, 2(GB)
while_test_0:
	LOAD 1(GB), R3
	LOAD #1, R2
	CMP R2, R3
	BEQ while_end_2
	BRA while_body_1
while_end_2:
; Load in R1 to be able to display
	LOAD 2(GB), R1
	WINT
	WNL
	HALT
; end main program
stack_overflow_error:
	WSTR "Error: Stack Overflow"
	WNL
	ERROR
div_by_zero_error:
	WSTR "Error: Division by zero"
	WNL
	ERROR
