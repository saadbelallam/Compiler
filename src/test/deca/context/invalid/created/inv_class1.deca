// Description:
//    Plusieurs classes avec attribut protégé pour la classe A
//
// Résultats:
//    Invalide contextuellement car attribut de la classe A protégé.
//
// Historique:
//    créé le 16/01/2025

class A {
    protected int x;
}

class X {
    void m() {
    A a = new A();
    println(a.x) ; // Erreur contextuelle : x est protege
    }

}